{
  "name": "anuncios-ia-app",
  "private": true,
  "version": "0.1.0",
  "description": "App local de Anuncios con IA: servidor en 127.0.0.1:4455 y la interfaz en el navegador.",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=./server server/index.js --dev",
    "dev:prueba": "node --watch-path=./server --import \"data:text/javascript,process.env.ANUNCIOS_MODO_PRUEBA='1'\" server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "~5.2.0",
    "vite": "~7.3.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
