{
  "$comment": "plan.json de un lote de anuncios de imagen (el PASO 4 de la skill). Las cantidades, los ids y las fuentes los revisa lib/imagen-ads/verificar.js.",
  "type": "object",
  "required": ["producto", "lote", "cantidad", "proporciones", "variaciones"],
  "properties": {
    "producto": { "type": "string" },
    "lote": { "type": "string" },
    "cantidad": { "type": "integer", "minimum": 1, "maximum": 100 },
    "proporciones": { "type": "array", "items": { "type": "string", "enum": ["1:1", "9:16"] } },
    "variaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fuente", "angulo_id", "angulo", "concepto", "titular", "escena", "camara"],
        "properties": {
          "id": { "type": "string", "pattern": "^V\\d{2,3}$" },
          "fuente": { "type": "string", "enum": ["referencia", "biblioteca"] },
          "referencia": { "type": "string" },
          "analisis_referencia": { "type": "object" },
          "formato_id": { "type": "string" },
          "formato": { "type": "string" },
          "angulo_id": { "type": "string", "minLength": 1 },
          "angulo": { "type": "string", "minLength": 1 },
          "concepto": { "type": "string" },
          "titular": { "type": "string", "minLength": 1 },
          "escena": { "type": "string", "minLength": 1 },
          "camara": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
