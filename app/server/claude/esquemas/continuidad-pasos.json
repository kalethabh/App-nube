{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "temp/<slug>/app/continuidad/pasos.json (lo escribe Claude en la tarea continuidad-pares): el prompt y la forma de cada paso de la cadena. La app los copia a continuidad.pasos[] del manifiesto.",
  "type": "object",
  "required": ["pasos"],
  "additionalProperties": false,
  "properties": {
    "pasos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["de", "a", "forma", "prompt_video"],
        "additionalProperties": false,
        "properties": {
          "de": { "type": "integer", "minimum": 1 },
          "a": { "type": "integer", "minimum": 1 },
          "forma": { "type": "string", "enum": ["entrar", "salir", "recorrer", "transformar", "entorno", "rodear"] },
          "prompt_video": { "type": "string", "minLength": 80, "maxLength": 6000 }
        }
      }
    }
  }
}
