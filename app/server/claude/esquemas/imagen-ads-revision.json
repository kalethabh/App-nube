{
  "$comment": "revision/R###.json de un lote de anuncios de imagen: una entrada por imagen de la tanda. Cada problema, una frase corta en español sencillo (la lee el usuario). correccion_en (solo con ok false): cómo corregirlo, corto y en inglés, para el reintento automático (lo lee el modelo de imagen).",
  "type": "object",
  "required": ["revisadas"],
  "properties": {
    "revisadas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pieza", "ok", "problemas"],
        "properties": {
          "pieza": { "type": "string", "pattern": "^V\\d{2,3}_(1x1|9x16)$" },
          "ok": { "type": "boolean" },
          "problemas": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
          "correccion_en": { "type": "string", "maxLength": 600 },
          "nota": { "type": "integer", "minimum": 1, "maximum": 10 },
          "puntajes": {
            "type": "object",
            "required": ["estructura", "dolor_visual", "titular", "texto_limpio", "frasco_fiel", "oferta_confianza", "diferencia_real"],
            "properties": {
              "estructura": { "type": "integer", "minimum": 0, "maximum": 10 },
              "dolor_visual": { "type": "integer", "minimum": 0, "maximum": 10 },
              "titular": { "type": "integer", "minimum": 0, "maximum": 10 },
              "texto_limpio": { "type": "integer", "minimum": 0, "maximum": 10 },
              "frasco_fiel": { "type": "integer", "minimum": 0, "maximum": 10 },
              "oferta_confianza": { "type": "integer", "minimum": 0, "maximum": 10 },
              "diferencia_real": { "type": "integer", "minimum": 0, "maximum": 10 }
            }
          }
        }
      }
    }
  }
}
