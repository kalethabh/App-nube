{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "app/letras.json (temp/<slug>/app/letras.json). Musical: las 2 o 3 letras que escribe Claude en la sesion de guion (FORMATO_LETRAS de anuncios-nuevos.js); al aprobar, la app le agrega \"elegida\" (n). Historia musical: la arma la app con la letra de cancion/peticion.json (tipo \"historia\", una sola opcion, ya elegida). La produccion la lee en familias/musical.js (letraElegida).",
  "type": "object",
  "required": ["titulo", "idioma", "visual", "opciones"],
  "properties": {
    "tipo": { "enum": ["opciones", "historia"] },
    "titulo": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idioma": { "enum": ["es", "en", "pt"] },
    "mercado": { "type": ["string", "null"], "maxLength": 60 },
    "angulo": { "type": "string", "maxLength": 400 },
    "etapa": { "type": "string", "maxLength": 160 },
    "visual": { "enum": ["crochet", "claymation", "zack-d-films"] },
    "vocalGender": { "enum": ["f", "m", null] },
    "elegida": { "type": "integer", "minimum": 1, "maximum": 3 },
    "elegidaEn": { "type": "string" },
    "opciones": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["n", "titulo", "letra", "estiloSuno"],
        "properties": {
          "n": { "type": "integer", "minimum": 1, "maximum": 3 },
          "titulo": { "type": "string", "minLength": 1, "maxLength": 120 },
          "concepto": { "type": "string", "maxLength": 600 },
          "letra": { "type": "string", "minLength": 20, "maxLength": 5000 },
          "estiloSuno": { "type": "string", "minLength": 5, "maxLength": 400 },
          "ideaVisual": { "type": "string", "maxLength": 1200 }
        }
      }
    },
    "decisiones": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "cambios_hechos": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
  }
}
