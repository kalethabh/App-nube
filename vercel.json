{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "build":{"env":{"NODEJS_HELPERS":"0"}},
 "buildCommand":"node deploy/nube/armar.mjs",
 "outputDirectory":"app/dist",
 "functions":{"api/puerta.mjs":{"maxDuration":800,"includeFiles":"deploy/nube/**"}},
 "daemons":{"motor":{"root":".","entrypoint":"deploy/nube/Dockerfile","instances":{"iad1":1},"resources":{"requests":{"memory":"8Gi"}},"terminationGracePeriodSeconds":3600}},
 "routes":[{"src":"/","dest":"/api/puerta"},{"src":"/index.html","dest":"/api/puerta"},{"handle":"filesystem"},{"src":"/(.*)","dest":"/api/puerta"}]
}
