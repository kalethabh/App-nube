segundo\": 2.8\n446\t    },\n447\t    {\n448\t      \"n\": 23,\n449\t      \"desde\": 96.7,\n450\t      \"hasta\": 106.76,\n451\t      \"duracion\": 10.06,\n452\t      \"fotograma\": \"tomas/toma-23.jpg\",\n453\t      \"tira\": \"tomas/movimiento/tira-23.jpg\",\n454\t      \"imagen\": {\n455\t        \"brillo\": 104.6,\n456\t        \"luz\": \"media\",\n457\t        \"saturacion\": 19.1,\n458\t        \"color\": \"apagado\",\n459\t        \"temperatura\": \"cálida\",\n460\t        \"movimiento\": 9,\n461\t        \"se_mueve\": \"mucho movimiento\"\n462\t      },\n463\t      \"dice\": \"Puede que todavía quede alguna, así que consíguete una botella antes de que se agoten otra vez.\",\n464\t      \"eventos\": [],\n465\t      \"palabras_por_segundo\": 1.69\n466\t    }\n467\t  ],\n468\t  \"texto\": \"Le dijeron flaca toda la vida, tres semanas con estas gotas y se acabó. Le dijeron que le iba a llenar la cola a tiempo pa' su día de playa, así que empezó a tomarse dos goteros de esto cada día. Pero ahora está encabroná, ni hablar puede, porque gastó sesenta dólares la semana pasada. Y ahí fue que vio que bajaron el precio, el más bajo que ha estado nunca. Estaba furiosa, pero sinceramente ni puede estar tan brava. Por lo bien que funcionó, solo lleva tres semanas tomándolo. El pantalón ya no le siente igual, no sé cómo. Hasta sus primos le empezaron a preguntar. Los fitoestrógenos le mandaron la señal que a su cuerpo le faltaba, la que le dice dónde guardar la grasa, no perderla. Dos goteros al día, eso fue to' lo que tomó. No fue su culpa que las sentadillas y los batidos no le dieran suerte. Casi ni lo prueba, pensó que era otro anuncio falso vendiendo promesas vacías, pero es solo su cadera, sus muslos y su cola los que se pusieron grandes. No cometas el mismo error que ella, ahora mismo te lo llevas con sesenta y siete por ciento de descuento, lo que sale a menos de un dólar al día. Pero ya casi se agota, así que puede que ya perdiste tu oportunidad. Así que si puedes, dale clic al link de abajo. Puede que todavía quede alguna, así que consíguete una botella antes de que se agoten otra vez.\",\n469\t  \"palabras_por_segundo\": 2.35,\n470\t  \"eventos_de_audio\": [],\n471\t  \"voz\": {\n472\t    \"f0\": 258,\n473\t    \"genero\": \"femenina\",\n474\t    \"variacion\": 8.6,\n475\t    \"expresiva\": true,\n476\t    \"ritmo\": 2.35,\n477\t    \"muestras\": 623\n478\t  },\n479\t  \"aviso\": null\n480\t}"}]},"parent_tool_use_id":null,"session_id":"41bc782f-3620-4f2e-b32b-0e7d8c065c95","uuid":"cbe02908-cf26-4d11-8174-66bd02c0636b","timestamp":"2026-11-21T21:49:04.428Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/kalethabh/Anuncios con IA/temp/aguaje-complex-3-en-1-agregar-20261121-1647/referencia/adn-base.json","content":"{\n  \"video\": \"original.mp4\",\n  \"duracion\": 106.76,\n  \"formato\": \"720x1280\",\n  \"vertical\": true,\n  \"tomas\": [\n    {\n      \"n\": 1,\n      \"desde\": 0,\n      \"hasta\": 2.33,\n      \"duracion\": 2.33,\n      \"fotograma\": \"tomas/toma-01.jpg\",\n      \"tira\": \"tomas/movimiento/tira-01.jpg\",\n      \"imagen\": {\n        \"brillo\": 83.4,\n        \"luz\": \"media\",\n        \"saturacion\": 23.6,\n        \"color\": \"apagado\",\n        \"temperatura\": \"cálida\",\n        \"movimiento\": 7.3,\n        \"se_mueve\": \"movimiento suave (cámara en mano o gestos)\"\n      },\n      \"dice\": \"Le dijeron flaca toda la vida,\",\n      \"eventos\": [],\n      \"palabras_por_segundo\": 2.58\n    },\n    {\n      \"n\": 2,\n      \"desde\": 2.33,\n      \"hasta\": 4.83,\n      \"duracion\": 2.5,\n      \"fotograma\": \"tomas/toma-02.jpg\",\n      \"tira\": \"tomas/movimiento/tira-02.jpg\",\n      \"imagen\": {\n        \"brillo\": 118.2,\n        \"luz\": \"media\",\n        \"saturacion\": 16.7,\n        \"color\": \"apagado\",\n        \"temperatura\": \"cálida\",\n        \"movimiento\": 13.7,\n        \"se_mueve\": \"mucho movimiento\"\n      },\n      \"dice\": \"tres seman