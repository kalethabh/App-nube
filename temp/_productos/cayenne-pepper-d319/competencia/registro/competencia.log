a7d":null,"reachDelta30d":null},"audience":{"targetedCountries":["CO"],"mainCountry":null,"gender":null,"ageMin":null,"ageMax":null},"rank":{"positionInPage":7,"currentRank":7,"rankDelta":null,"improvementPct":25},"flags":{"isEuAd":null,"isLowReach":false,"isMediaChanged":true,"hasPartnerBadge":false}},{"id":"facebook_1632515017852655","collationId":"1527780938882188","platform":"facebook","status":"inactive","createdAt":"2026-04-18T10:00:39.883Z","firstSeenAt":"2026-04-18T07:00:00.000Z","lastSeenAt":"2026-11-19T12:52:47.447Z","daysRunning":215,"media":{"type":"video","thumbnailUrl":"https://medias.trendtrack.io/facebook/thumbnails/ffb39b597b76b624e6c59580889f57ef412c3a9a3f4c4b084bb56574dae88597.jpg","mediaUrl":"https://medias.trendtrack.io/facebook/video/dc51d138a26eedaeef3cc9e25cbb6c6d355af1b9291e13110d486a08f1ab5747.mp4"},"advertiser":{"id":"1050270561502684","name":"Salud Masculina","logoUrl":"https://medias.trendtrack.io/profile_picture/1050270561502684.jpg","facebookPageId":"1050270561502684","liveAdsCount":198,"reach30d":21790,"totalReach":471725,"countriesCount":4,"facebookLikes":2515,"instagramFollowers":null},"content":{"title":null,"body":"\"Las primeras dos semanas sentí calor en los pies por primera vez en años. A la tercera dejé de necesitar dos cafés para funcionar. A la quinta semana mi esposa me preguntó qué me estaba pasando, que le recordaba a ese hombre con el que se casó — sin que yo le dijera nada.\"\n— Ricardo F., 56 años.\n\nSovexa Lab — Cápsulas de Capsaicina Activa. La fórmula que más de 35.000 hombres ya están usando para restaurar su circulación desde adentro.\n\n✅ Restaura el flujo sanguíneo que la edad fue cerrando — más oxígeno, más nutrientes, más calor llegando a cada rincón de tu cuerpo.\n✅ Cápsula blanda sin ardor — toda la potencia de la cayena concentrada sin tocar el estómago.\n✅ 6 ingredientes con razón mecanística — capsaicina, remolacha, K2, D3, vitamina E y ginseng. Cada uno sabe por qué está ahí.\n✅ Energía sostenida todo el día — no un pico de 4 horas que después lo deja peor.\n✅ Resultados en semanas — y el efecto se acumula con el uso, no se desvanece.\n\nNo es magia. Es bioquímica. Y los primeros en notarlo van a ser las personas que te rodean.\n\nGarantía de 90 días — si no sientes el cambio, te devolvemos el 100% de tu dinero\n\nPincha \"Más información\" — hasta 60% de descuento. Solo en el sitio oficial.","transcript":"Soy la pastilla azul. Solo funciono dos horas, con receta, y solo si tu cuerpo todavía produce óxido nítrico por su cuenta. Si esa puerta ya está cerrada, yo no la abro. Soy el shilajit. Me venden como el secreto del Himalaya. Pero soy solo minerales crudos tirados en un estómago que ni siquiera puede absorberme. Básicamente, soy una piedra cara. Soy la testosterona en pastilla. Prometo devolverte lo que perdiste a los 40, pero mi hígado me destruye antes de llegar a tu sangre. Soy orina cara con etiqueta de gimnasio. Soy el jugo de remolacha. Te doy una señal de óxido nítrico que dura 90 minutos. Después vuelves exactamente al mismo lugar donde empezaste. Soy un saludo, no una solución. Soy el ajo crudo. El remedio de tu abuela. Funcioné cuando ella tenía 60, en 1970. Pregúntale a tu esposa si quiere que huelas así esta noche. Soy la capsaicina del pimiento de cayena. Yo no empujo tu sangre. Activo una puerta molecular llamada TRPV1 que tu cuerpo dejó de abrir después de los 40. Cuando abro, todo fluye. Soy Sobexalab. No soy un parche de dos horas. Cuando la capsaicina abre TRPV1, tu cuerpo produce su propio óxido nítrico, como lo hacía a los 30. Sin receta. Sin reloj. No estoy solo. Traigo remolacha para una segunda vía de óxido nítrico. Vitamina E que lo protege. K2 que mantiene tus arterias flexibles. D3 para tu testosterona. Y ginseng, el único con estudios clínicos humano. El Viagra bloquea una enzima para que el poco óxido nítrico que te queda no se pierda. Yo hago que produzcas más. Mismo destino. Caminos opuestos. Uno defensivo. Uno ofensivo. Más de 35.000 clientes felices ya abrieron la puerta. El cambio se siente en semanas. No en horas. No en minutos. En semanas reales. Como funciona la biología. Y cuando vuelve, vuelve para quedarse. Me encuentras en sobexagionlab.com. Hasta 60% de descuento esta semana y 90 views de garantía. Si no sientes la diferencia, te devuelvo cada peso. La puerta ya está abierta.","callToAction":"LEARN MORE","landingPageUrl":"https://sovexa-lab.com/pages/us-1","landingPageDomain":"sovexa-lab.com","ctaDescription":"La Fórmula De Circulación Masculina Que Se Agotó 7 Veces En Un Año","ctaLinkDescription":"Sovexa Lab"},"metrics":{"reach":44710,"aggregatedReach":null,"estimatedSpend":402,"duplicates":14,"reachDelta1d":null,"reachDelta7d":137,"reachDelta30d":1460},"audience":{"targetedCountries":["CO","ES","MX","US"],"mainCountry":"ES","gender":null,"ageMin":null,"ageMax":null},"rank":{"positionInPage":4,"currentRank":4,"rankDelta":null,"improvementPct":3.17},"flags":{"isEuAd":null,"isLowReach":false,"isMediaChanged":true,"hasPartnerBadge":false}}],"pagination":{"page":1,"limit":6,"total":2232,"totalPages":372,"offset":0,"isTotalApproximate":false},"meta":{"query":"cayena","keywords":[],"searchIn":"ad_copy","categoryIds":[],"country":null,"countryFilterKind":"audienceCountry","adCountries":{"include":["CO"]},"mainCountries":[],"trendSignal":"reach_growth_7d","sortBy":"mostDuplicates","order":"desc","requestedLimit":6,"effectiveLimit":6,"activeOnly":true,"status":"all","page":1,"minTrafficGrowthPercent":null,"trafficGrowthPeriod":"last30d","trafficGrowth":null,"adsGrowth":null,"pageReachGrowth":null,"adReachGrowth":null,"language":null,"adLanguages":[],"cta":[],"currency":null,"currencies":[],"shopifyAppIds":[],"excludeShopifyAppIds":[],"pixelIds":[],"excludePixelIds":[],"themeIds":[],"filters":{"search":["cayena"],"searchType":"adCopy","keywordMode":"any","sortBy":"mostDuplicates","order":"desc","page":1,"limit":6,"platforms":["facebook"],"status":"all","adCountries":{"include":["CO"]}},"war