diato y sin costos adicionales. 🛡️✅\n\n👇 Toca el botón de abajo, selecciona tus colores y dale a tus pies el alivio que necesitan hoy mismo.","transcript":null,"callToAction":"SEE DETAILS","landingPageUrl":"https://nimocol.com/pc-i-2-pares/","landingPageDomain":"nimocol.com","ctaDescription":"🛡️ Asegurar Mi Promo","ctaLinkDescription":"View this page published on nimocol.com"},"metrics":{"reach":null,"aggregatedReach":null,"estimatedSpend":null,"duplicates":75,"reachDelta1d":null,"reachDelta7d":null,"reachDelta30d":null},"audience":{"targetedCountries":["CO"],"mainCountry":null,"gender":null,"ageMin":null,"ageMax":null},"rank":{"positionInPage":7,"currentRank":7,"rankDelta":0,"improvementPct":1.9},"flags":{"isEuAd":null,"isLowReach":true,"isMediaChanged":true,"hasPartnerBadge":false}}],"pagination":{"page":1,"limit":4,"total":142,"totalPages":36,"offset":0,"isTotalApproximate":false},"meta":{"query":null,"keywords":["circulación","piernas"],"searchIn":"ad_copy","categoryIds":[],"country":null,"countryFilterKind":"audienceCountry","adCountries":{"include":["CO"]},"mainCountries":[],"trendSignal":"reach_growth_7d","sortBy":"mostDuplicates","order":"desc","requestedLimit":4,"effectiveLimit":4,"activeOnly":true,"status":"active","page":1,"minTrafficGrowthPercent":null,"trafficGrowthPeriod":"last30d","trafficGrowth":null,"adsGrowth":null,"pageReachGrowth":null,"adReachGrowth":null,"language":null,"adLanguages":[],"cta":[],"currency":null,"currencies":[],"shopifyAppIds":[],"excludeShopifyAppIds":[],"pixelIds":[],"excludePixelIds":[],"themeIds":[],"filters":{"search":["circulación","piernas"],"searchType":"adCopy","keywordMode":"all","sortBy":"mostDuplicates","order":"desc","page":1,"limit":4,"platforms":["facebook"],"minDaysRunning":30,"status":"active","adCountries":{"include":["CO"]}},"warnings":[],"paginationMaxOffset":10000},"fieldGuide":{"countryBreakdowns":[{"path":"data[].audience.targetedCountries","meaning":"Full ad targeting country list, including non-EU market