rs.","transcript":null,"callToAction":"LEARN MORE","landingPageUrl":"http://try.aurivita.co/pdp","landingPageDomain":"try.aurivita.co","ctaDescription":"20 Years In Adult Films Taught Me One Thing About Fixing ED. My Daughter Just Made Me Rank Them All.","ctaLinkDescription":null},"metrics":{"reach":31813,"aggregatedReach":null,"estimatedSpend":286,"duplicates":9,"reachDelta1d":348,"reachDelta7d":7510,"reachDelta30d":31385},"audience":{"targetedCountries":["AU","CA","GB","US"],"mainCountry":"GB","gender":null,"ageMin":null,"ageMax":null},"rank":{"positionInPage":2,"currentRank":2,"rankDelta":1,"improvementPct":2.04},"flags":{"isEuAd":null,"isLowReach":false,"isMediaChanged":true,"hasPartnerBadge":false}},{"id":"facebook_1774364667107786","collationId":"28696288733324868","platform":"facebook","status":"active","createdAt":"2026-10-16T06:21:30.629Z","firstSeenAt":"2026-10-15T07:00:00.000Z","lastSeenAt":"2026-11-22T22:35:22.798Z","daysRunning":40,"media":{"type":"video","thumbnailUrl":"https://medias.trendtrack.io/facebook/thumbnails/539cf521bc875bbc17f4182d95ba2110dffc84f949d4580e49cea3740e8928c1.jpg","mediaUrl":"https://medias.trendtrack.io/facebook/video/6dd8bde013aeec84cf5115e2f652ba70f6b4078cad2cded591cfd65ed3a5a9a0.mp4"},"advertiser":{"id":"860657403805344","name":"Men's Wellbeing","logoUrl":"https://medias.trendtrack.io/profile_picture/860657403805344.jpg","facebookPageId":"860657403805344","liveAdsCount":501,"reach30d":521776,"totalReach":2676062,"countriesCount":4,"facebookLikes":1121,"instagramFollowers":null},"content":{"title":null,"body":"\"🤔 Still the same guy. Just… less of him when it counts.\n\nYou still hit the gym. You still eat right. But something's quietly slipping. And you know exactly what it is.\n\nIt's not age. It's not stress. It's blood flow. When your vessels narrow and nitric oxide drops, less blood reaches where it needs to go. That's it. That's the whole problem.\n\nAurivita Cayenne Pepper Softgels open the pipes back up. Cayenne, Beetr