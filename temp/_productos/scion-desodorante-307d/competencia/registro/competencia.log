ull},\"rank\":{\"positionInPage\":22,\"currentRank\":22,\"rankDelta\":null,\"improvementPct\":36.67},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1202381638722251\",\"collationId\":\"1086154677086889\",\"platform\":\"facebook\",\"status\":\"inactive\",\"createdAt\":\"2026-08-06T15:02:07.202Z\",\"firstSeenAt\":\"2026-08-05T07:00:00.000Z\",\"lastSeenAt\":\"2026-09-16T07:00:00.000Z\",\"daysRunning\":42,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/c6cf757a6d0b181afee1f13b24c318331c710833242204ec74c5398d2cbcb308.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/7d4f930afc458aa1e57fc6452322de30a15a82133762ce8244a17d857150ca25.mp4\"},\"advertiser\":{\"id\":\"150226862224800\",\"name\":\"Taza Skin Clinic (166-168 Triệu Nữ Vương, P. Hải Châu, Tp. Đà Nẵng)\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/150226862224800.jpg\",\"facebookPageId\":\"150226862224800\",\"liveAdsCount\":49,\"reach30d\":0,\"totalReach\":0,\"countriesCount\":1,\"facebookLikes\":17573,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"CẢNH BÁO: CHỊ EM ĐANG DÙNG LĂN KHỬ MÙI MỖI NGÀY ĐỌC NGAY KẺO HỐI HẬN!\\nBạn tưởng lăn khử mùi là \\\"chân ái\\\" cứu vớt mùa hè này?\\nSự thật phũ phàng: Hóa chất trong lăn khử mùi khi hòa quyện với mồ hôi không hề làm hết mùi, mà tạo ra một thứ mùi \\\"chua nồng\\\" khủng khiếp hơn! Chưa kể, nó bít tắc lỗ chân lông khiến nách viêm sần, thâm đen và những vệt ố vàng vĩnh viễn trên chiếc áo sơ mi đắt tiền của bạn.\\n\\nĐừng \\\"đày đọa\\\" vùng cánh thêm nữa. Thanh tẩy ổ vi khuẩn và lấy lại tự tin với phác đồ NANO PLUS - Chỉ 399K tại Taza:\\n✨ Xóa sổ vi khuẩn gây mùi: Ánh sáng Nano len lỏi sâu, phá vỡ môi trường sống của vi khuẩn, trả lại vùng cánh khô ran, sạch sẽ.\\n✨ Đánh bay thâm sần: Hỗ trợ làm sáng vùng da xỉn màu do cạo nhổ, lạm dụng hóa chất.\\n✨ Trải nghiệm VIP 1:1: Không gian điều trị riêng tư 100%, kín đáo, chị em thoải mái thư giãn không lo chạm mặt ai.\\n✨ Nhanh gọn lẹ: 60 phút thực hiện êm ái, trưa làm chiều đi quẩy bình thường!\\n\\n🔥 DEAL SỐC THÁNG NÀY: Suất trải nghiệm Nano Plus 399K (Chỉ dành cho 20 suất đăng ký sớm).\\n👉 [ĐỂ LẠI SĐT] hoặc [INBOX NGAY] để Taza giúp bạn quẳng gánh lo \\\"viêm cánh\\\" ngay hôm nay!\\n=============\\nHOTLINE: 1900.2664\",\"transcript\":null,\"callToAction\":\"MESSAGE PAGE\",\"landingPageUrl\":null,\"landingPageDomain\":null,\"ctaDescription\":\"Deal hời: Xử lý hôi nách chỉ 399K\",\"ctaLinkDescription\":null},\"metrics\":{\"reach\":null,\"aggregatedReach\":null,\"estimatedSpend\":null,\"duplicates\":6,\"reachDelta1d\":null,\"reachDelta7d\":null,\"reachDelta30d\":null},\"audience\":{\"targetedCountries\":[\"VN\"],\"mainCountry\":null,\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":14,\"currentRank\":14,\"rankDelta\":null,\"improvementPct\":46.67},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1566572414925062\",\"collationId\":\"2625491077922810\",\"platform\":\"facebook\",\"status\":\"inactive\",\"createdAt\":\"2026-08-03T11:26:38.128Z\",\"firstSeenAt\":\"2026-08-03T07:00:00.000Z\",\"lastSeenAt\":\"2026-09-16T07:00:00.000Z\",\"daysRunning\":44,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/7fad372e0ce50b81af4e90033b67e4084b8a7017e124ace937fb374bf6009e7b.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/fcadcc6a630cdaacf65783af34e77a6df068e76e607d714d36282834d4b6bb76.mp4\"},\"advertiser\":{\"id\":\"150226862224800\",\"name\":\"Taza Skin Clinic (166-168 Triệu Nữ Vương, P. Hải Châu, Tp. Đà Nẵng)\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/150226862224800.jpg\",\"facebookPageId\":\"150226862224800\",\"liveAdsCount\":49,\"reach30d\":0,\"totalReach\":0,\"countriesCount\":1,\"facebookLikes\":17573,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"🍑 CHỈ 599K: \\\"TẠM BIỆT\\\" THÂM CHÂN LÂU NĂM - TƯ TIN KHOE DÁNG!\\n\\nKem bôi không cứu nổi thâm chân chai lì của bạn đâu! Vì gốc thâm bám rễ ở tầng sâu. Thử ngay phác đồ Whitening Plus - Giải quyết tận gốc khuyết điểm chỉ với 599K:\\n\\n🔸 Khử thâm: Ánh sáng quang học bắn vỡ melanin, xóa sổ mảng tối màu.\\n🔸 Tái sinh da: Đẩy tinh chất chuyên sâu, dọn sạch sần vỏ cam, trả lại nền da láng mịn.\\n\\nAn tâm tuyệt đối với tiêu chuẩn khắt khe:\\n✔️ Riêng tư 100% với phòng điều trị 1:1.\\n✔️ Cực kỳ êm ái: Không châm chích, không bong tróc, làm xong sinh hoạt bình thường.\\n✔️ Chuyên gia trực tiếp lên phác đồ, cam kết hiệu quả bằng văn bản.\\n\\n🔥 CHỐT DEAL 599K NGAY ĐỂ TỰ TIN DIỆN MỌI OUTFIT!\\nĐể lại SĐT hoặc Inbox, Taza xếp lịch cho bạn ngay nhé!\",\"transcript\":null,\"callToAction\":\"MESSAGE PAGE\",\"landingPageUrl\":null,\"landingPageDomain\":null,\"ctaDescription\":\"SẠCH THÂM CHÂN  CHỈ SAU 1 PHÁC ĐỒ\",\"ctaLinkDescription\":null},\"metrics\":{\"reach\":null,\"aggregatedReach\":null,\"estimatedSpend\":null,\"duplicates\":6,\"reachDelta1d\":null,\"reachDelta7d\":null,\"reachDelta30d\":null},\"audience\":{\"targetedCountries\":[\"VN\"],\"mainCountry\":null,\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":46,\"currentRank\":46,\"rankDelta\":null,\"improvementPct\":85.19},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_991236670536600\",\"collationId\":\"1615471846194647\",\"platform\":\"facebook\",\"status\":\"inactive\",\"createdAt\":\"2026-07-08T07:36:41.997Z\",\"firstSeenAt\":\"2026-05-21T07:00:00.000Z\",\"lastSeenAt\":\"2026-11-17T03:34:44.060Z\",\"daysRunning\":180,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/82b1b2290153f7dd26b5eff8549678195d8a5734436486c960da65e79942efcc.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/3c69a7f0589180d755343f33bf605921dcc833f9252a978bb4951b4f7c9e40d2.mp4\"},\"advertiser\":{\"id\":\"150226862224800\",\"name\":\"Taza Skin Clinic (166-168 Triệu Nữ Vương, P. Hải Châu, Tp. Đà Nẵng)\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/150226862224800.jpg\",\"facebookPageId\":\"150226862224800\",\"liveAdsCount\":49,\"reach30d\":0,\"totalReach\":0,\"countriesCount\":1,\"facebookLikes\":17573,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"💢 Cảnh báo các con vợ phí tiền TRẮNG ẢO GIẢ TRÂN… 399K này BẬT 3 TONE THẬT nè!\\nDạo này thấy nhiều con vợ bị “lừa dễ” quá…\\n😭 Bôi thì trắng đó… mà ra nắng là lộ nguyên hình trắng bệt thấy sợ luôn!\\n😭 Đúng kiểu mặt - cổ - tay - chân… lệch tone, nhìn không giống ai\\n😭 Đau nhất là: tốn tiền mà còn mất luôn cái vẻ da phát sáng xịn xịn\\n🔥 Muốn trắng thì phải trắng kiểu da khỏe – bật tone, chứ đừng trắng ảo quê mùa lắm\\n \\nChốt nhẹ 399K: NANO VÀNG 24K CHUẨN MỰC NÂNG TONE trong liệu trình tắm trắng cao cấp\\nỨng dụng công nghệ ánh sáng kép đa tầng phi thuyền Nhật Bản điều chỉnh sắc tố có chọn lọc - da thích nghi - duy trì lâu dài:\\n✅ Làm mờ sắc tố tối màu, nâng 2-3 tone sáng da dần theo chu kỳ tự nhiên\\n✅ Thay lớp da xỉn lì cho bề mặt tươi mới và trắng hồng\\n✅ Kích nền da khỏe, ẩm mượt và có độ bóng từ gốc\\n✅ Tone sáng duy trì ổn định, không bật lên rồi tụt xuống\\n \\nLiệu trình kết hợp bộ “chất xịn”\\n🔸Vitamin C thế hệ mới: làm sáng, đều màu\\n🔸Glutathione tinh lọc: cải thiện sắc tố X10\\n🔸Collagen peptide: tăng độ đàn hồi, da căng mịn\\n \\n🎯Cơ chế nâng tone theo nhịp sinh học da có kiểm soát: Sáng trong - Ổn định lâu dài\\n✅ Không trắng ảo – nói không với hồi tone, bệt màu hay bắt nắng\\n \\n👙 Hè tới rồi… Da mà không bật tone là mặc đồ mất nửa cái đẹp luôn á\\n💸 399K mà được combo: bật tone – không trắng ảo – da nhìn xịn mịn\\n📩 Các con vợ muốn bật tone thật – không giả trân thì inbox liền nha!\\n=======================\\nTAZA SKIN CLINIC – TRUNG TÂM PEEL & PHỤC HỒI DA SINH HỌC CHUẨN KHOA HỌC - 8 CHI NHÁNH TRÊN TOÀN QUỐC - THÀNH LẬP 2014\\n☎️ Hotline: 1900 2664\\n#tamtrang #trangbody #trang #battone #datrang #tamtrangbody\",\"transcript\":\"Rồi hôm nay anh sẽ chỉ cho các con vợ cách để luôn tự tin hơn con nhỏ đứng cạnh mình. Đó là biến hình từ một con vịt đen sâu xí trở thành con thiên nga trắng toát, may mắn hơn. Da da đang có ưu đãi tắm trắng phi thuyền nano vàng hai tư k chỉ với ba trăm chín mươi chín k, đảm bảo an toàn tuyệt đối, phù hợp không lộ tẩy, không trắng ảo đâu các con vợ ơi. Sử dụng ánh sáng kép đa tầng từ máy phi thuyền quét sạch melanin, đầy sâu các dưỡng chất như vitamin C, blue tay sần vàng hai tư k cho làn da của vợ sáng bật liền ba tông chỉ sau một buổi luôn. ưu đãi có giới hạn thôi, các con vợ nhanh tay đăng ký liền nhé.\",\"callToAction\":\"MESSAGE PAGE\",\"landingPageUrl\":null,\"landingPageDomain\":null,\"ctaDescription\":\"Số lượng ưu đãi có hạn. Đặt lịch ngay\",\"ctaLinkDescription\":null},\"metrics\":{\"reach\":null,\"aggregatedReach\":null,\"estimatedSpend\":null,\"duplicates\":5,\"reachDelta1d\":null,\"reachDelta7d\":null,\"reachDelta30d\":null},\"audience\":{\"targetedCountries\":[\"VN\"],\"mainCountry\":null,\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":43,\"currentRank\":43,\"rankDelta\":null,\"improvementPct\":93.48},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1071811355264820\",\"collationId\":\"1571024421272035\",\"platform\":\"facebook\",\"status\":\"inactive\",\"createdAt\":\"2026-08-06T15:02:07.202Z\",\"firstSeenAt\":\"2026-08-05T07:00:00.000Z\",\"lastSeenAt\":\"2026-09-14T07:00:00.000Z\",\"daysRunning\":40,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/c6cf757a6d0b181afee1f13b24c318331c710833242204ec74c5398d2cbcb308.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/7d4f930afc458aa1e57fc6452322de30a15a82133762ce8244a17d857150ca25.mp4\"},\"advertiser\":{\"id\":\"150226862224800\",\"name\":\"Taz