\n          [\"Oportunidad · versión honesta (rutina, comida y ejercicio)\", \"Ya existe\", \"Prueba\", \"naturalfittco y Comerca: «lo sumas a tu entrenamiento y buena alimentación» · 4 a 8 días\"],\n          [\"Oportunidad · el mensajero de confianza (la tía, la prima)\", \"Ya existe\", \"Sostenido\", \"Doc. Vital, cápsulas de aguaje: «mi tía me dijo: antes del bisturí, prueba lo natural» · 34 días, 79 copias\"],\n          [\"Contrario · miedo a los biopolímeros\", \"Sin verificar\", \"\", \"22 anuncios con la palabra; el único leído era de otro tema\"],\n          [\"Avatar · la flaca que come y no sube\", \"Ya existe\", \"Prueba\", \"Rhommerce y Zendre.Store\"],\n          [\"Avatar · la del gimnasio que no ve cambios\", \"Ya existe\", \"Sostenido\", \"Creatina con colágeno (46 días) y naturalfittco (3 días)\"],\n          [\"Avatar · la que piensa en operarse\", \"Ya existe\", \"Consolidado\", \"Gomitas de aguaje (409 días) y cápsulas de aguaje (34 días, 79 copias)\"],\n          [\"Avatar · la dejada por una con más curvas\", \"Parecido\", \"Prueba\", \"Solo como frase suelta\"],\n          [\"Avatar · la que ya probó y desconfía\", \"Parecido\", \"Consolidado\", \"Natural Shop vende «original contra falsificado» con sus gomitas · 235 días\"],\n          [\"Avatar · la que quiere llegar distinta a un evento\", \"No existe\", \"\", \"No apareció en lo leído\"],\n          [\"Avatar · mujer de más de 40\", \"Parecido\", \"\", \"Gomitas de fenogreco para otra promesa (deseo y resequedad después de los 40). No para curvas\"]\n        ], \"nota\": \"Dato: cada fila sale de anuncios leídos o de conteos por palabra. «Ya existe» solo cuenta competencia directa (suplementos que se toman). «Sin verificar» quiere decir que la búsqueda por texto no puede encontrarlo.\" },\n        { \"tipo\": \"caja\", \"estilo\": \"hipotesis\", \"titulo\": \"Ángulos locales que no estaban en la investigación original\", \"texto\": \"\", \"items\": [\n          \"Dato: **el aguaje es el 