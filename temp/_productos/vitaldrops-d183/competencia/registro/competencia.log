":\"shopamua.com\",\"ctaDescription\":\"Embrace your curves, naturally\",\"ctaLinkDescription\":\"Supports your natural curves with a 100% natural formula.\"},\"metrics\":{\"reach\":241,\"aggregatedReach\":null,\"estimatedSpend\":2,\"duplicates\":2,\"reachDelta1d\":0,\"reachDelta7d\":0,\"reachDelta30d\":0},\"audience\":{\"targetedCountries\":[\"GB\",\"US\"],\"mainCountry\":\"GB\",\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":77,\"currentRank\":77,\"rankDelta\":0,\"improvementPct\":16.89},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}}],\"pagination\":{\"page\":1,\"limit\":10,\"total\":194,\"totalPages\":20,\"offset\":0,\"isTotalApproximate\":false},\"meta\":{\"query\":\"shopamua.com\",\"keywords\":[],\"searchIn\":\"domain\",\"categoryIds\":[],\"country\":null,\"countryFilterKind\":\"audienceCountry\",\"adCountries\":null,\"mainCountries\":[],\"trendSignal\":\"reach_growth_7d\",\"sortBy\":\"longestRunning\",\"order\":\"desc\",\"requestedLimit\":10,\"effectiveLimit\":10,\"activeOnly\":true,\"status\":\"all\",\"page\":1,\"minTrafficGrowthPercent\":null,\"trafficGrowthPeriod\":\"last30d\",\"trafficGrowth\":null,\"adsGrowth\":null,\"pageReachGrowth\":null,\"adReachGrowth\":null,\"language\":null,\"adLanguages\":[],\"cta\":[],\"currency\":null,\"currencies\":[],\"shopifyAppIds\":[],\"excludeShopifyAppIds\":[],\"pixelIds\":[],\"excludePixelIds\":[],\"themeIds\":[],\"filters\":{\"search\":[\"shopamua.com\"],\"searchType\":\"domain\",\"keywordMode\":\"any\",\"sortBy\":\"longestRunning\",\"order\":\"desc\",\"page\":1,\"limit\":10,\"platforms\":[\"facebook\"],\"status\":\"all\"},\"warnings\":[],\"paginationMaxOffset\":10000},\"fieldGuide\":{\"countryBreakdowns\":[{\"path\":\"data[].audience.targetedCountries\",\"meaning\":\"Full ad targeting country list, including non-EU markets such as US.\"},{\"path\":\"data[].audience.mainCountry\",\"meaning\":\"Primary audience country from Meta's EU/UK ad