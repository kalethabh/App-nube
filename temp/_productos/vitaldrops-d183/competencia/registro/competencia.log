bca7ce03cd11888f2948c6d30a2bd782c54fe68fe7b36bab1cb7ebab.png\"},\"advertiser\":{\"id\":\"627927290397159\",\"name\":\"Sierra Voss Romance Author\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/627927290397159.jpg\",\"facebookPageId\":\"627927290397159\",\"liveAdsCount\":13,\"reach30d\":79655,\"totalReach\":705453,\"countriesCount\":4,\"facebookLikes\":727,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"Never let a hot older stranger buy you a dress.\\nEspecially if he's Bratva royalty...\\n\\nSo I'm trying on this insanely expensive gown.\\nSome skinny snob laughs at my curves.\\n“Honey, that dress wasn't made for your figure.”\\n\\nThen a gorgeous older man steps in.\\nLooks me up and down like he's starving.\\n“The dress is yours on one condition. You wear it tonight at dinner.”\\n\\nHe wasn't asking...\\n\\nThat night he spoiled me with Russian delicacies.\\nAte dessert right off my body.\\nAnd buried himself in every broken part of me.\\n\\nI had no idea he was my ex's older brother.\\n\\nOr that he'd never let me out of his sight again.\\n\\n❤️ The Wrong Brother: An Age Gap Bratva Romance. Read FREE with Kindle Unlimited.  A Top 50 Amazon bestseller.\",\"transcript\":null,\"callToAction\":\"SHOP NOW\",\"landingPageUrl\":\"https://www.amazon.com/dp/B0HCJM76QT\",\"landingPageDomain\":\"amazon.com\",\"ctaDescription\":\"Spicy Mafia Romance\",\"ctaLinkDescription\":\"The Wrong Brother. An Amazon Top 50 bestelling romance. Mafia romance, age gap, silver fox, curvy girl, surprise baby. Read with Kindle Unlimited\"},\"metrics\":{\"reach\":52962,\"aggregatedReach\":null,\"estimatedSpend\":477,\"duplicates\":15,\"reachDelta1d\":855,\"reachDelta7d\":5893,\"reachDelta30d\":43485},\"audience\":{\"targetedCountries\":[\"AU\",\"CA\",\"GB\",\"US\"],\"mainCountry\":\"GB\",\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":4,\"currentRank\":4,\"rankDelta\":0,\"improvementPct\":33.33},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1132668562455241\",\"collationId\":\"29044464105238179\",\"platform\":\"facebook\",\"status\":\"active\",\"createdAt\":\"2026-10-30T16:21:08.347Z\",\"firstSeenAt\":\"2026-10-30T07:00:00.000Z\",\"lastSeenAt\":\"2026-11-04T07:22:17.362Z\",\"daysRunning\":17,\"media\":{\"type\":\"image\",\"thumbnailUrl\":null,\"mediaUrl\":\"https://medias.trendtrack.io/facebook/image/5d8bf8f07bb64c3fcc938a930fde6c30a03f4cccd321e723a8b0cc8991303c57.png\"},\"advertiser\":{\"id\":\"221671734361494\",\"name\":\"Mia Mara Romance Books\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/221671734361494.jpg\",\"facebookPageId\":\"221671734361494\",\"liveAdsCount\":140,\"reach30d\":826238,\"totalReach\":5047452,\"countriesCount\":2,\"facebookLikes\":5864,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"I never thought my curves were desirable.\\nUntil a hot, older stranger walks in on me—naked.\\n\\nI’m in my hotel room, shimmying in front of the mirror, feeling anything but sexy.\\n\\nThen I turn.\\nAnd he’s there.\\nShirtless, unapologetic, and holding a key to my room.\\n\\nHis eyes slowly take in every inch of me.\\n“You have no idea what those curves are doing to my self-control.”\\n\\nThat night in the marble shower he couldn’t get enough of me.\\n\\nBut I ran, never to see him again.\\n\\nUntil I walk into a job interview—and he’s behind the desk.\\n\\nMorgan Bale. Billionaire CEO. Luxury resort mogul.\\n\\nMy new boss.\\n\\nBut now he's arrogant and cold.\\nAnd pretends not to recognize me.\\n\\nFine. I'll pretend too.\\n\\nBecause this is every travel writer’s dream job.\\nSee the world. One five-star destination at a time.\\n\\nAnd a chance to work through my bucket list.\\nLike skinny dipping in the wild and sleeping under the stars.\\n\\nThere's just one catch.\\n\\nIt's with him.\\nDay and night.\\nAnd I have to pretend to be his fiancée.\\n\\nAnd to top it all off?\\n\\nI'm staring at two pink lines.\\n\\n❤️ Wrong Room, Right Billionaire: An Age Gap Boss Romance. Read FREE with Kindle Unlimited.\",\"transcript\":null,\"callToAction\":\"SHOP NOW\",\"landingPageUrl\":\"https://www.amazon.com/dp/B0HD6CYMDL\",\"landingPageDomain\":\"amazon.com\",\"ctaDescription\":\"🔥 Spicy Billionaire Romance\",\"ctaLinkDescription\":\"Wrong Room, Right Billionaire: An Age Gap Boss Romance (Unintentionally Yours)\"},\"metrics\":{\"reach\":10424,\"aggregatedReach\":null,\"estimatedSpend\":94,\"duplicates\":3,\"reachDelta1d\":0,\"reachDelta7d\":2914,\"reachDelta30d\":9820},\"audience\":{\"targetedCountries\":[\"GB\",\"US\"],\"mainCountry\":\"GB\",\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":30,\"currentRank\":30,\"rankDelta\":-2,\"improvementPct\":26.79},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1555354416616589\",\"collationId\":\"1593224945887554\",\"platform\":\"facebook\",\"status\":\"active\",\"createdAt\":\"2026-11-10T09:47:45.177Z\",\"firstSeenAt\":\"2026-11-09T08:00:00.000Z\",\"lastSeenAt\":\"2026-11-14T18:30:23.675Z\",\"daysRunning\":7,\"media\":{\"type\":\"image\",\"thumbnailUrl\":null,\"mediaUrl\":\"https://medias.trendtrack.io/facebook/image/56d52e49ee86d5576ab910f774e7c10bf0bfdb3ae999a9a7fe99ebe3605b39cb.png\"},\"advertiser\":{\"id\":\"743408562183926\",\"name\":\"JUICi\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/743408562183926.jpg\",\"facebookPageId\":\"743408562183926\",\"liveAdsCount\":1720,\"reach30d\":829117,\"totalReach\":10743049,\"countriesCount\":1,\"facebookLikes\":733,\"instagramFollowers\":6444},\"content\":{\"title\":null,\"body\":\"skinny legs? try JUICi.\\n\\ntraining legs but they still won't build shape? women store up to 70–80% less creatine than men, so muscle never gets the fuel to grow.\\n\\none scoop: 5g creatine, 1000mg collagen, 1000mg bcaas. peach passion, raspberry lemonade or cherry crus