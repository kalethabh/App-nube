":[],\"paginationMaxOffset\":10000},\"fieldGuide\":{\"countryBreakdowns\":[{\"path\":\"data[].audience.targetedCountries\",\"meaning\":\"Full ad targeting country list, including non-EU markets such as US.\"},{\"path\":\"data[].audience.mainCountry\",\"meaning\":\"Primary audience country from Meta's EU/UK ad transparency data; null for ads outside that scope, even when the ad targets those markets.\"},{\"path\":\"data[].advertiser.countriesCount\",\"meaning\":\"Number of advertiser countries detected; not a country split.\"}],\"richNestedData\":[{\"path\":\"data[].collationId\",\"meaning\":\"Identifier of the combined creative represented by this search result. Pass it as scan_ad.collation_id to scan the same aggregate instead of only the representative ad.\"},{\"path\":\"data[].advertiser\",\"meaning\":\"Facebook page identity, reach, followers, and live ads.\"},{\"path\":\"data[].content\",\"meaning\":\"Ad copy, transcript fallback, CTA, and landing page.\"},{\"path\":\"data[].media\",\"meaning\":\"Media type, thumbnails, and media URLs.\"},{\"path\":\"data[].metrics\",\"meaning\":\"Reach, spend estimate, deltas, and duplicate metrics.\"},{\"path\":\"data[].audience\",\"meaning\":\"Country, gender, and age targeting fields.\"},{\"path\":\"data[].flags\",\"meaning\":\"EU, low-reach, media-changed, and partner-badge flags.\"}]},\"credits\":{\"requestedUnits\":10,\"effectiveUnits\":10,\"actualUnits\":10,\"costUnits\":15,\"recurringUnits\":15,\"topupUnits\":0,\"creditsRemaining\":4235,\"creditsSourceHeader\":\"recurring\",\"failurePhase\":null,\"releaseAttempted\":false,\"releaseSucceeded\":null}}"}]},"parent_tool_use_id":null,"session_id":"050709ec-1d38-454b-bab0-c8707f43781e","uuid":"eda9c12e-05d0-4e41-ac17-7fdae0015e79","timestamp":"2026-11-16T14:59:45.189Z","tool_use_result":{"content":"{\"requestId\":\"0d302eba-ccc5-4dfa-b078-763cea2ed18b\",\"data\":[{\"id\":\"facebook_1008332222095422\",\"collationId\":\"2059659028763569\",\"platform\":\"facebook\",\"status\":\"active\",\"createdAt\":\"2026-07-14T17:47:44.312Z\",\"firstSeenAt\":\"2026-07-13T07:00:00.000Z\",\"lastSeenAt\":\"2026-08-18T06:06:39.597Z\",\"daysRunning\":126,\"media\":{\"type\":\"image\",\"thumbnailUrl\":null,\"mediaUrl\":\"https://medias.trendtrack.io/facebook/image/a1fb612b324ec9d528255efdb3863ddefe611de0e7eba9ff246df5fe1b8b9c88.jpg\"},\"advertiser\":{\"id\":\"1120223791172422\",\"name\":\"Roseline William\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/1120223791172422.jpg\",\"facebookPageId\":\"1120223791172422\",\"liveAdsCount\":565,\"reach30d\":295225,\"totalReach\":1104995,\"countriesCount\":3,\"facebookLikes\":1657,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"I used to avoid standing next to my thick friends in pictures.\\n\\nNot because I didn't love my girls.\\n\\nBecause every photo was proof of what I didn't have.\\n\\nHips.\\n\\nShape.\\n\\nA body that gets noticed without saying a word.\\n\\nI'd look at those pictures and see it clear as day.\\n\\nThey looked like women. I looked like somebody's little sister.\\n\\n========\\n\\nAnd it wasn't just pictures.\\n\\nLast month I had the whole bar rocking at karaoke night.\\n\\nSang two songs. Got the crowd going. The bar gave us free drinks because of it.\\n\\nMy friend brought her homegirl with us. Girl barely said a word all night. Stayed on her phone. Didn't move from her seat.\\n\\nAnd she STILL got approached. Twice.\\n\\nMe? Paid dust. Again.\\n\\nIt's the barista who's dry with me but perks all the way up when my thick friend orders.\\n\\nIt's random strangers giving her compliments while I'm standing right there.\\n\\nIt's men asking her questions, being nice to her in a way I just don't experience.\\n\\nI used to joke that I'm the personality hire. \\n\\nBut after enough nights like that, it stops being a joke.\\n\\n========\\n\\nI'm gonna be honest about something a lot of us feel but don't say.\\n\\nWhere I'm from, if you're not thick, you're invisible.\\n\\nI've been slim my whole life. Little to no butt, square shape, no hips.\\n\\nThe kind of body people tell you to be grateful for.\\n\\nMeanwhile I watched girls get smiles, conversations, whole relationships just for walking into a room.\\n\\nThey got a foot in the door for free.\\n\\nI had to earn mine every single time. And most nights the door never opened.\\n\\n========\\n\\nAnd here's the part that made it worse.\\n\\nI was doing EVERYTHING they tell you to do.\\n\\nOver a year in the gym. Squats, hip thrusts, lunges, all of it.\\n\\nThree, four days a week. Sore for two.\\n\\nMy butt got higher. Firmer. But there was no meat in it. \\n\\nAll that work and my jeans fit exactly the same.\\n\\nSo then it was eat more. I ate more. It went everywhere except where I wanted it.\\n\\nThen the weight gain shakes. Spent hundreds. Got a bigger stomach and the same flat behind.\\n\\nAnd every time something failed, the same thought got louder.\\n\\nMaybe it's just genetics. Maybe this is just my body.\\n\\nI even caught myself looking up BBL prices one night at 2am, and that's when I knew it had gone too far.\\n\\nBecause I shouldn't have to choose between staying invisible and going under a knife.\\n\\n========\\n\\nThen I found VitalDrops.\\n\\nI didn't believe it at first. Every supplement online promises you some overnight miracle.\\n\\nBut then I read the reviews.\\n\\nHundreds of women built exactly like me before they started. Slim. Flat. Tired of being overlooked.\\n\\nWomen saying the same thing I'd been thinking for years, that they tried everything and nothing stuck.\\n\\nIt wasn't one perfect story. It was hundreds of the same story.\\n\\nThat's what made me stop scrolling.\\n\\n========\\n\\nAnd the way it works finally explained WHY nothing ever worked.\\n\\nMy body always knew how to be curvy. It just wasn't getting the signal.\\n\\nStress keeps that signal blocked. Like too much noise in the way.\\n\\nAshwagandha clears the noise.\\n\\nMaca root and fenugreek support your natural feminine balance.\\n\\nSo your body finally sends the weight where you want it. Hips. Thighs. Butt.\\n\\nThat's why the gym never worked. Squats build muscle, but they can't tell your body where to store fat.\\n\\nAnd them shakes? Made for men. That's why we got nothing to show for them but a gut.\\n\\nA year of squats couldn't do what the right signal did in weeks.\\n\\nIt was never about more effort. It was never bad genetics either.\\n\\nWe just never had the signal.\\n\\n========\\n\\nFirst few weeks, small changes. My appetite. The way my jeans sat.\\n\\nAround week six, my leggings started fitting different. Not everywhere. Just in the places I always wanted.\\n\\nBy month three, my side profile changed so much my cousin asked me dead in my face if I got work done.\\n\\nNope.\\n\\n========\\n\\nBut I'ma tell you the part that actually matters.\\n\\nMen that used to walk right past me are turning their heads now.\\n\\nAsking me questions. Getting nervous around me.\\n\\nA man I've known for YEARS looked at me last month like he just met me.\\n\\nAnd my personality finally got a foot in the door.\\n\\nBecause now people stay long enough to notice it.\\n\\nLast weekend my girls posted our pictures from the function.\\n\\nI'm front and center in every single one.\\n\\n========\\n\\nSo if you're the one hiding on the end in every group picture..\\n\\nIf you've been squatting for a year with nothing to show for it..\\n\\nIf you're the funny one, the smart one, the one who always has to prove she's worth talking to..\\n\\nIt was never your effort. It was never your genetics.\\n\\nYour body just never got the signal.\\n\\nVitalDrops comes with a money back guarantee, so you're not risking anything to find out.\\n\\nAnd right now it's Buy 2, Get 1 Free at the link below.\\n\\nI just wish somebody had told me sooner.\",\"transcript\":null,\"callToAction\":\"LEARN MORE\",\"landingPageUrl\":\"https://shopamua.com/products/amua-vitaldrops\",\"landingPageDomain\":\"shopamua.com\",\"ctaDescription\":\"I Thought I’d Stay the Skinny Girl Nobody Notices… Then I Tried These Drops\",\"ctaLinkDescription\":\"Supports your natural curves with a 100% natural formula.\"},\"metrics\":{\"reach\":20331,\"aggregatedReach\":null,\"estimatedSpend\":183,\"duplicates\":12,\"reachDelta1d\":0,\"reachDelta7d\":0,\"reachDelta30d\":0},\"audience\":{\"targetedCountries\":[\"CA\",\"GB\",\"US\"],\"mainCountry\":\"GB\",\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":4,\"currentRank\":4,\"rankDelta\":1,\"improvementPct\":0.75},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1051005344544858\",\"collationId\":\"1358805122299880\",\"platform\":\"facebook\",\"status\":\"active\",\"createdAt\":\"2026-07-23T02:28:41.991Z\",\"firstSeenAt\":\"2026-07-21T07:00:00.000Z\",\"lastSeenAt\":\"2026-11-15T11:37:39.745Z\",\"daysRunning\":118,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/3416a5bf36b9c87f9e078e5e0fed2d85bfce6e636125472237ba032b6710417b.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/e142cf579d0e8a23c64a248425578eb74b54d5a91548a2d0bf9f5b9c4faf6683.mp4\"},\"advertiser\":{\"id\":\"496995063506769\",\"name\":\"Amua\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/496995063506769.jpg\",\"facebookPageId\":\"496995063506769\",\"liveAdsCount\":555,\"reach30d\":126886,\"totalReach\":2026434,\"countriesCount\":2,\"facebookLikes\":16382,\"instagramFollowers\":18803},\"content\":{\"title\":null,\"body\":\"Feel confident in your body with a natural blend designed to support healthy weight gain in the right places!\",\"transcript\":\"Do not buy, I'm on vital drops If you like being invisible Do not buy, I'm on vital drops If you like your skinny booty Do not buy, I'm on vital drops If you like your shapeless body Do not buy, I'm on vital drops She's been taking, I'm on vital drops for three weeks And now she has to return it Her doctor told her phytostrogens wouldn't lift her, but he was wrong What the fuck did these natural plants do to her booty in three weeks? These are the drops that made her ass fat They told her it was gonna help with her curves But they did not wonder how fast it was gonna work She's been taking these for only two weeks now And her jeans don't sit the same no more Her ex hit a line out of nowhere One morning talking about you look different Even her homegirl who used to get all the attention started asking questions One drop of a date, that's all she took It wasn't her fault, that squats and shakes never worked Because it was all because her body's signal was off The mock-off in the Greek and that swag I'm gonna wake that signal back up The one that tells her body where to actually put the weight Hip, style, booty, not a stomach And when that signal comes back home The curves just show up Plus she thought it was gonna taste nasty But it's smooth, no weird aftertaste Just a couple drops under the tongue Now you can keep doing endless squats at the gym But she'll just be over here taking one drop a day Watching the curves come in And they're doing a huge sale right now Up to 75% off with a 90 day money back guarantee Just click the link below And get yourself a bottle before they sell out again And get yourself a bottle of bill Yeah, yeah, yeah So like you practices Just be reached And if you want to come back Sure baki Put it in the slide So here's for me Put it in the inside This one And there you can use museum I want to buy it The one So here's for you Yeah, so here's for you Yeah, so here's for you And let's listen And if you swim And let's listen It doesn't matter Yeah, so there's for you Yeah, so you can see And at the montag You, I want to let's listen There we go Yeah, so did you Yeah, so here's for this It's for you\",\"callToAction\":\"SHOP NOW\",\"landingPageUrl\":\"https://shopamua.com/pages/curve-quiz\",\"landingPageDomain\":\"shopamua.com\",\"ctaDescription\":\"Embrace your curves, naturally\",\"ctaLinkDescription\":null},\"metrics\":{\"reach\":15463,\"aggregatedReach\":null,\"estimatedSpend\":139,\"duplicates\":2,\"reachDelta1d\":0,\"reachDelta7d\":0,\"reachDelta30d\":0},\"audience\":{\"targetedCountries\":[\"GB\",\"US\"],\"mainCountry\":\"GB\",\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":7,\"currentRank\":7,\"rankDelta\":0,\"improvementPct\":1.54},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1921706715169973\",\"collationId\":\"870468342429510\",\"platform\":\"facebook\",\"status\":\"inactive\",\"createdAt\":\"2026-07-14T17:47:44.312Z\",\"firstSeenAt\":\"2026-07-13T07:00:00.000Z\",\"lastSeenAt\":\"2026-11-07T11:55:14.750Z\",\"daysRunning\":117,\"media\":{\"type\":\"image\",\"thumbnailUrl\":null,\"mediaUrl\":\"https://medias.trendtrack.io/facebook/image/05d2fd2c75de775b843ab443f9ca2c55e8e734c289afdbc2315e84dc86677016.jpg\"},\"advertiser\":{\"id\":\"1120223791172422\",\"name\":\"Roseline William\",\"logoUrl\":\"https://medias.trendtrack.io/profile_picture/1120223791172422.jpg\",\"facebookPageId\":\"1120223791172422\",\"liveAdsCount\":565,\"reach30d\":295225,\"totalReach\":1104995,\"countriesCount\":3,\"facebookLikes\":1657,\"instagramFollowers\":null},\"content\":{\"title\":null,\"body\":\"I used to avoid standing next to my thick friends in pictures.\\n\\nNot because I didn't love my girls.\\n\\nBecause every photo was proof of what I didn't have.\\n\\nHips.\\n\\nShape.\\n\\nA body that gets noticed without saying a word.\\n\\nI'd look at those pictures and see it clear as day.\\n\\nThey looked like women. I looked like somebody's little sister.\\n\\n========\\n\\nAnd it wasn't just pictures.\\n\\nLast month I had the whole bar rocking at karaoke night.\\n\\nSang two songs. Got the crowd going. The bar gave us free drinks because of it.\\n\\nMy friend brought her homegirl with us. Girl barely said a word all night. Stayed on her phone. Didn't move from her seat.\\n\\nAnd she STILL got approached. Twice.\\n\\nMe? Paid dust. Again.\\n\\nIt's the barista who's dry with me but perks all the way up when my thick friend orders.\\n\\nIt's random strangers giving her compliments while I'm standing right there.\\n\\nIt's men asking her questions, being nice to her in a way I just don't experience.\\n\\nI used to joke that I'm the personality hire. \\n\\nBut after enough nights like that, it stops being a joke.\\n\\n========\\n\\nI'm gonna be honest about something a lot of us feel but don't say.\\n\\nWhere I'm from, if you're not thick, you're invisible.\\n\\nI've been slim my whole life. Little to no butt, square shape, no hips.\\n\\nThe kind of body people tell you to be grateful for.\\n\\nMeanwhile I watched girls get smiles, conversations, whole relationships just for walking into a room.\\n\\nThey got a foot in the door for free.\\n\\nI had to earn mine every single time. And most nights the door never opened.\\n\\n========\\n\\nAnd here's the part that made it worse.\\n\\nI was doing EVERYTHING they tell you to do.\\n\\nOver a year in the gym. Squats, hip thrusts, lunges, all of it.\\n\\nThree, four days a week. Sore for two.\\n\\nMy butt got higher. Firmer. But there was no meat in it. \\n\\nAll that work and my jeans fit exactly the same.\\n\\nSo then it was eat more. I ate more. It went everywhere except where I wanted it.\\n\\nThen the weight gain shakes. Spent hundreds. Got a bigger stomach and the same flat behind.\\n\\nAnd every time something failed, the same thought got louder.\\n\\nMaybe it's just genetics. Maybe this is just my body.\\n\\nI even caught myself looking up BBL prices one night at 2am, and that's when I knew it had gone too far.\\n\\nBecause I shouldn't have to choose between staying invisible and going under a knife.\\n\\n========\\n\\nThen I found VitalDrops.\\n\\nI didn't believe it at first. Every supplement online promises you some overnight miracle.\\n\\nBut then I read the reviews.\\n\\nHundreds of women built exactly like me before they started. Slim. Flat. Tired of being overlooked.\\n\\nWomen saying the same thing I'd been thinking for years, that they tried everything and nothing stuck.\\n\\nIt wasn't one perfect story. It was hundreds of the same story.\\n\\nThat's what made me stop scrolling.\\n\\n========\\n\\nAnd the way it works finally explained WHY nothing ever worked.\\n\\nMy body always knew how to be curvy. It just wasn't getting the signal.\\n\\nStress keeps that signal blocked. Like too much noise in the way.\\n\\nAshwagandha clears the noise.\\n\\nMaca root and fenugreek support your natural feminine balance.\\n\\nSo your body finally sends the weight where you want it. Hips. Thighs. Butt.\\n\\nThat's why the gym never worked. Squats build muscle, but they can't tell your body where to store fat.\\n\\nAnd them shakes? Made for men. That's why we got nothing to show for them but a gut.\\n\\nA year of squats couldn't do what the right signal did in weeks.\\n\\nIt was never about more effort. It was never bad genetics either.\\n\\nWe just never had the signal.\\n\\n========\\n\\nFirst few weeks, small changes. My appetite. The way my jeans sat.\\n\\nAround week six, my leggings started fitting different. Not everywhere. Just in the places I always wanted.\\n\\nBy month three, my side profile changed so much my cousin asked me dead in my face if I got work done.\\n\\nNope.\\n\\n========\\n\\nBut I'ma tell you the part that actually matters.\\n\\nMen that used to walk right past me are turning their heads now.\\n\\nAsking me questions. Getting nervous around me.\\n\\nA man I've known for YEARS looked at me last month like he just met me.\\n\\nAnd my personality finally got a foot in the door.\\n\\nBecause now people stay long enough to notice it.\\n\\nLast weekend my girls posted our pictures from the function.\\n\\nI'm front and center in every single one.\\n\\n========\\n\\nSo if you're the one hiding on the end in every group picture..\\n\\nIf you've been squatting for a year with nothing to show for it..\\n\\nIf you're the funny one, the smart one, the one who always has to prove she's worth talking to..\\n\\nIt was never your effort. It was never your genetics.\\n\\nYour body just never got the signal.\\n\\nVitalDrops comes with a money back guarantee, so you're not risking anything to find out.\\n\\nAnd right now it's Buy 2, Get 1 Free at the link below.\\n\\nI just wish somebody had told me sooner.\",\"transcript\":null,\"callToAction\":\"LEARN MORE\",\"landingPageUrl\":\"https://shopamua.com/products/amua-vitaldrops\",\"landingPageDomain\":\"shopamua.com\",\"ctaDescription\":\"I Thought I’d Stay the Skinny Girl Nobody Notices… Then I Tried These Drops\",\"ctaLinkDescription\":\"Supports your natural curves with a 100% natural formula.\"},\"metrics\":{\"reach\":4753,\"aggregatedReach\":null,\"estimatedSpend\":43,\"duplicates\":10,\"reachDelta1d\":null,\"reachDelta7d\":null,\"reachDelta30d\":0},\"audience\":{\"targetedCountries\":[\"CA\",\"GB\",\"US\"],\"mainCountry\":\"GB\",\"gender\":null,\"ageMin\":null,\"ageMax\":null},\"rank\":{\"positionInPage\":40,\"currentRank\":40,\"rankDelta\":null,\"improvementPct\":11.02},\"flags\":{\"isEuAd\":null,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_4467606006814607\",\"collationId\":\"2121306808802558\",\"platform\":\"facebook\",\"status\":\"active\",\"createdAt\":\"2026-07-24T02:35:25.799Z\",\"firstSeenAt\":\"2026-07-22T07:00:00.000Z\",\"lastSeenAt\":\"2026-08-26T00:15:31.975Z\",\"daysRunning\":117,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/85d7664275cd5222c4adca2fd6ad0c6f9b8573cd145dc3a006bec6aded5a3588.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/046b937864d88c668be307f6013d8200418860532efe17d43ed57b1bdfc3e35d.mp4\"},\"advert