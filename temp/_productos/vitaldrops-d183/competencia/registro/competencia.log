lta\":0,\"improvementPct\":6.25},\"flags\":{\"isEuAd\":true,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1466765231971800\",\"collationId\":\"2234220644105491\",\"platform\":\"facebook\",\"status\":\"active\",\"createdAt\":\"2026-10-22T01:22:20.051Z\",\"firstSeenAt\":\"2026-10-21T07:00:00.000Z\",\"lastSeenAt\":\"2026-11-15T08:35:43.490Z\",\"daysRunning\":26,\"media\":{\"type\":\"video\",\"thumbnailUrl\":\"https://medias.trendtrack.io/facebook/thumbnails/0fdf0793a9c95d16c31813974ab2c97d8a4ff99b6b382cd8e65254f15e2f0bf0.jpg\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/video/95d282aec55e302b5124f262670a5aa92b68c8089efcf9a445455389f9221e17.mp4\"},\"advertiser\":{\"id\":\"105237105263904\",\"name\":\"Op. Dr. Burak Pasinlioğlu\",\"logoUrl\":\"https://medias.trendtrack.io/facebook/profile_picture/105237105263904.jpg\",\"facebookPageId\":\"105237105263904\",\"liveAdsCount\":87,\"reach30d\":210680,\"totalReach\":1351239,\"countriesCount\":1,\"facebookLikes\":2251,\"instagramFollowers\":34544},\"content\":{\"title\":null,\"body\":\"Istanbul Türkiye. 🇹🇷 Holiday and Health, All in One 🇹🇷\\nDouble Board Certified Surgeon Known as Dr. Burak Pasinlioğlu\\n- Private Transfer, \\n- Hotel Stay, \\n- Pre-Surgery Meeting, \\n- Final Consultation, \\n- Operation\\n- Hospital Stay\\n- Recovery and Aftercare in Istanbul\\n- Final Check-Up\\n- Return Home\",\"transcript\":\"This is a BBL that I wouldn't recommend because it looks unnatural and more importantly, it is risky for you. But this is a BBL I would call safe and natural. Exaggerated BBLs come with high risk, such as fat embolism, which can be life-threatening. That's why I operate only Safe BBL, which shapes your natural contours safely and effectively in a minimalistic way. With Safe BBL, we can minimize the risk. The main difference of the Safe BBL method is that the fat is injected under the skin instead of into the muscle. Muscle tissue is highly vascular, increasing the risk of fat embolism. However, under the skin, this risk is minimized. Additionally, in Safe BBL, we apply the fat to the hip tips, the depression on the sides rather than the center of the buttocks. This area is safer for fat injection as well. Remember, it is not about following trends, but about embracing and enhancing your natural beauty in the safest way possible.\",\"callToAction\":\"WHATSAPP MESSAGE\",\"landingPageUrl\":\"https://api.whatsapp.com/send\",\"landingPageDomain\":\"api.whatsapp.com\",\"ctaDescription\":\"Istanbul Türkiye. 🇹🇷 Holiday and Health, All in One 🇹🇷\",\"ctaLinkDescription\":\"Thinking about a Brazilian Butt Lift (BBL)? Let’s talk safety. 💬\\n\\nNot all BBLs are created equal. While some may promise dramatic results, they may come with significant risks, including the potential for life-threatening complications like fat embolism.\\n\\nBut there’s a safer, more natural option: the Safe BBL method. 🌿 By injecting fat under the skin rather than into the muscle, we minimize risks while still achieving beautiful, subtle enhancements. 🍑 Plus, by focusing on the hips and sides rather than the center, we ensure a harmonious, balanced look.\\n\\nAt our clinic, safety and natural beauty go hand in hand. 💖 Our goal isn’t to follow trends, but to enhance your unique features in the safest way possible.\\n\\nReady to enhance your curves with confidence? Contact us today to learn more about our Safe BBL procedure! ✨\"},\"metrics\":{\"reach\":13323,\"aggregatedReach\":null,\"estimatedSpend\":120,\"duplicates\":1,\"reachDelta1d\":247,\"reachDelta7d\":2916,\"reachDelta30d\":13182},\"audience\":{\"targetedCountries\":[\"IE\"],\"mainCountry\":\"IE\",\"gender\":\"women\",\"ageMin\":18,\"ageMax\":65},\"rank\":{\"positionInPage\":13,\"currentRank\":13,\"rankDelta\":3,\"improvementPct\":31.71},\"flags\":{\"isEuAd\":true,\"isLowReach\":false,\"isMediaChanged\":true,\"hasPartnerBadge\":false}},{\"id\":\"facebook_1409943964328335\",\"collationId\":\"31521766583207