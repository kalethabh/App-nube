:13775},{"date":"2026-09-06","totalImpressions":20076},{"date":"2026-09-07","totalImpressions":19559},{"date":"2026-09-08","totalImpressions":20073},{"date":"2026-09-09","totalImpressions":20795},{"date":"2026-09-10","totalImpressions":20539},{"date":"2026-09-11","totalImpressions":16006},{"date":"2026-09-12","totalImpressions":16687},{"date":"2026-09-13","totalImpressions":4239},{"date":"2026-09-14","totalImpressions":6535},{"date":"2026-09-15","totalImpressions":7495},{"date":"2026-09-16","totalImpressions":7106},{"date":"2026-09-17","totalImpressions":16392},{"date":"2026-09-18","totalImpressions":11788},{"date":"2026-09-19","totalImpressions":18057},{"date":"2026-09-20","totalImpressions":11530},{"date":"2026-09-21","totalImpressions":11914},{"date":"2026-09-22","totalImpressions":18696},{"date":"2026-09-23","totalImpressions":14772},{"date":"2026-09-24","totalImpressions":0},{"date":"2026-09-25","totalImpressions":22110},{"date":"2026-09-26","totalImpressions":13059},{"date":"2026-09-27","totalImpressions":7893},{"date":"2026-09-28","totalImpressions":8103},{"date":"2026-09-29","totalImpressions":12484},{"date":"2026-09-30","totalImpressions":11337},{"date":"2026-10-01","totalImpressions":13989},{"date":"2026-10-02","totalImpressions":11306},{"date":"2026-10-03","totalImpressions":9868},{"date":"2026-10-04","totalImpressions":8230},{"date":"2026-10-05","totalImpressions":17305},{"date":"2026-10-06","totalImpressions":13867},{"date":"2026-10-07","totalImpressions":16187},{"date":"2026-10-08","totalImpressions":13093},{"date":"2026-10-09","totalImpressions":11269},{"date":"2026-10-10","totalImpressions":15151},{"date":"2026-10-11","totalImpressions":17155},{"date":"2026-10-12","totalImpressions":13123},{"date":"2026-10-13","totalImpressions":11305},{"date":"2026-10-14","totalImpressions":13294},{"date":"2026-10-15","totalImpressions":8884},{"date":"2026-10-16","totalImpressions":25176},{"date":"2026-10-17","totalImpressions":20570},{"date":"2026-10-18","totalImpressions":43798},{"date":"2026-10-19","totalImpressions":29980},{"date":"2026-10-20","totalImpressions":26290},{"date":"2026-10-21","totalImpressions":19257},{"date":"2026-10-22","totalImpressions":16026},{"date":"2026-10-23","totalImpressions":16137},{"date":"2026-10-24","totalImpressions":20638},{"date":"2026-10-25","totalImpressions":0},{"date":"2026-10-26","totalImpressions":50808},{"date":"2026-10-27","totalImpressions":12672},{"date":"2026-10-28","totalImpressions":11954},{"date":"2026-10-29","totalImpressions":11748},{"date":"2026-10-30","totalImpressions":13931},{"date":"2026-10-31","totalImpressions":11089},{"date":"2026-11-01","totalImpressions":11691},{"date":"2026-11-02","totalImpressions":0},{"date":"2026-11-03","totalImpressions":32508},{"date":"2026-11-04","totalImpressions":31893},{"date":"2026-11-05","totalImpressions":54875},{"date":"2026-11-06","totalImpressions":32822},{"date":"2026-11-07","totalImpressions":20720},{"date":"2026-11-08","totalImpressions":24344},{"date":"2026-11-09","totalImpressions":42917},{"date":"2026-11-10","totalImpressions":34511},{"date":"2026-11-11","totalImpressions":31233},{"date":"2026-11-12","totalImpressions":28019},{"date":"2026-11-13","totalImpressions":0},{"date":"2026-11-14","totalImpressions":26329},{"date":"2026-11-15","totalImpressions":28249},{"date":"2026-11-16","totalImpressions":28068},{"date":"2026-11-17","totalImpressions":29377},{"date":"2026-11-18","totalImpressions":10525},{"date":"2026-11-19","totalImpressions":23450},{"date":"2026-11-20","totalImpressions":15981},{"date":"2026-11-21","totalImpressions":14485},{"date":"2026-11-22","totalImpressions":13658},{"date":"2026-11-23","totalImpressions":17930},{"date":"2026-11-24","totalImpressions":16413},{"date":"2026-11-25","totalImpressions":21214},{"date":"2026-11-26","totalImpressions":16412}],"facebookLikesHistory":[{"date":"2026-04-20","value":48},{"date":"2026-04-21","value":48},{"date":"2026-04-22","value":76},{"date":"2026-04-23","value":76},{"date