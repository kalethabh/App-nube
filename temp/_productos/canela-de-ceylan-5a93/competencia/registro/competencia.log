alLikes\":null},\"activity\":{\"activeAds\":null,\"totalAds\":null,\"avgActiveAds7d\":null,\"avgActiveAds30d\":null},\"lastUpdatedAt\":null},\"googleAds\":{\"status\":\"available\",\"liveAds\":0,\"adsLaunched30d\":0,\"reach\":{\"value\":null,\"label\":\"Google reported reach\",\"euUkOnly\":false},\"topCountries\":[],\"platformMix\":[]},\"latestAds\":[{\"id\":\"facebook_1476597887951617\",\"mediaType\":\"image\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/image/b78393a83cfa36412d317dcc033a77cce7167be9ff3f0317556ce1c6fb4d7574.jpg\",\"thumbnailUrl\":null},{\"id\":\"facebook_1670101854519139\",\"mediaType\":\"image\",\"mediaUrl\":\"https://medias.trendtrack.io/facebook/image/c1adeaa9334860c5c4dc1c9ca567eb920ef7d333a97f893bb6bd2cb71dda7adb.jpg\",\"thumbnailUrl\":null}]}],\"pagination\":{\"page\":1,\"limit\":1,\"offset\":0,\"total\":1},\"meta\":{\"query\":\"carloszapatadr.com\",\"matchMode\":\"exact\",\"requestedLimit\":1,\"effectiveLimit\":1,\"page\":1,\"sortBy\":\"activeAds\",\"order\":\"desc\",\"warnings\":[],\"queryFallback\":false,\"broadQueryFallback\":false,\"fallbackReason\":null},\"credits\":{\"requestedUnits\":1,\"effectiveUnits\":1,\"actualUnits\":1,\"costUnits\":4,\"recurringUnits\":4,\"topupUnits\":0,\"creditsRemaining\":9526,\"creditsSourceHeader\":\"recurring\",\"failurePhase\":null,\"releaseAttempted\":false,\"releaseSucceeded\":null}}"}]},"parent_tool_use_id":"toolu_01BM6ojhxoKRmXtc5hHHY9MK","agent_id":"a93b4961117d83ab3","session_id":"f17f1593-2f67-4602-83cb-0d79fa14ee5c","uuid":"ffc3ddb6-ee93-4fce-81f9-82a6cb7fd53a","timestamp":"2026-11-27T18:51:25.601Z","tool_use_result":{"_meta":{"io.modelcontextprotocol/serverInfo":{"name":"trendtrack-server","version":"0.0.1"}}},"tool_result_meta":[{"id":"toolu_01K9qoi6EF2dqDhgFFbKHaed","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}],"subagent_type":"general-purpose","task_description":"Validación Colombia canela Ceylán"}
