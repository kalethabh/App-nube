":\"2026-07-08\",\"value\":1240},{\"date\":\"2026-07-09\",\"value\":1261},{\"date\":\"2026-07-10\",\"value\":1884},{\"date\":\"2026-07-11\",\"value\":4028},{\"date\":\"2026-07-12\",\"value\":6404},{\"date\":\"2026-07-13\",\"value\":8342},{\"date\":\"2026-07-14\",\"value\":10696},{\"date\":\"2026-07-15\",\"value\":12112},{\"date\":\"2026-07-16\",\"value\":13456},{\"date\":\"2026-07-17\",\"value\":15153},{\"date\":\"2026-07-18\",\"value\":16880},{\"date\":\"2026-07-19\",\"value\":18561},{\"date\":\"2026-07-20\",\"value\":20705},{\"date\":\"2026-07-21\",\"value\":23455},{\"date\":\"2026-07-22\",\"value\":26148},{\"date\":\"2026-07-23\",\"value\":28775},{\"date\":\"2026-07-24\",\"value\":30800},{\"date\":\"2026-07-25\",\"value\":31243},{\"date\":\"2026-07-26\",\"value\":31792},{\"date\":\"2026-07-27\",\"value\":32238},{\"date\":\"2026-07-28\",\"value\":32730},{\"date\":\"2026-07-29\",\"value\":33205},{\"date\":\"2026-07-30\",\"value\":33659},{\"date\":\"2026-07-31\",\"value\":34140},{\"date\":\"2026-08-01\",\"value\":34661},{\"date\":\"2026-08-02\",\"value\":35253},{\"date\":\"2026-08-03\",\"value\":35681},{\"date\":\"2026-08-04\",\"value\":36101},{\"date\":\"2026-08-05\",\"value\":36101},{\"date\":\"2026-08-06\",\"value\":36739},{\"date\":\"2026-08-07\",\"value\":37219},{\"date\":\"2026-08-08\",\"value\":37719},{\"date\":\"2026-08-09\",\"value\":38201},{\"date\":\"2026-08-10\",\"value\":38787},{\"date\":\"2026-08-11\",\"value\":39483},{\"date\":\"2026-08-12\",\"value\":39548},{\"date\":\"2026-08-13\",\"value\":39558},{\"date\":\"2026-08-14\",\"value\":39563},{\"date\":\"2026-08-15\",\"value\":39591},{\"date\":\"2026-08-16\",\"value\":39642},{\"date\":\"2026-08-17\",\"value\":39695},{\"date\":\"2026-08-18\",\"value\":39697},{\"date\":\"2026-08-19\",\"value\":39715},{\"date\":\"2026-08-20\",\"value\":39722},{\"date\":\"2026-08-21\",\"value\":39734},{\"date\":\"2026-08-22\",\"value\":39754},{\"date\":\"2026-08-23\",\"value\":39798},{\"date\":\"2026-08-24\",\"value\":39867