 el drenaje natural de tu cuerpo. Se toman en tu vaso de agua, como indica la etiqueta.\n\n🚚 Envío gratis a toda Colombia\n🤝 Pagas al recibir, en la puerta de tu casa\n\nToca el botón y pide el tuyo.","transcript":null,"callToAction":"SHOP NOW","landingPageUrl":"https://tusojoslindos.shop/products/lymphatic-drainage-apoyo-linfatico?utm_source=meta&utm_medium=paid&utm_campaign=dln_mvadlib_img_2411_g2","landingPageDomain":"tusojoslindos.shop","ctaDescription":"Drenaje linfático en gotas 🌿","ctaLinkDescription":"Nature's Sunshine Lymphatic Drainage es un suplemento dietario líquido a base de extractos herbales, formulado para brindar apoyo tradicional al sistema linf..."},"metrics":{"reach":null,"aggregatedReach":null,"estimatedSpend":null,"duplicates":null,"reachDelta1d":null,"reachDelta7d":null,"reachDelta30d":null},"audience":{"targetedCountries":["CO"],"mainCountry":null,"gender":null,"ageMin":null,"ageMax":null},"rank":{"positionInPage":202,"currentRank":202,"rankDelta":0,"improvementPct":41.31},"flags":{"isEuAd":null,"isLowReach":false,"isMediaChanged":true,"hasPartnerBadge":false}}],"pagination":{"page":1,"limit":1,"total":147,"totalPages":147,"offset":0,"isTotalApproximate":false},"meta":{"query":null,"keywords":["drenaje linfático","Sunshine"],"searchIn":"ad_copy","categoryIds":[],"country":null,"countryFilterKind":"audienceCountry","adCountries":{"include":["CO"]},"mainCountries":[],"trendSignal":"reach_growth_7d","sortBy":"newest","order":"desc","requestedLimit":1,"effectiveLimit":1,"activeOnly":true,"status":"active","page":1,"minTrafficGrowthPercent":null,"trafficGrowthPeriod":"last30d","trafficGrowth":null,"adsGrowth":null,"pageReachGrowth":null,"adReachGrowth":null,"language":null,"adLanguages":[],"cta":[],"currency":null,"currencies":[],"shopifyAppIds":[],"excludeShopifyAppIds":[],"pixelIds":[],"excludePixelIds":[],"themeIds":[],"filters":{"search":["drenaje linfático","Sunshine"],"searchType":"adCopy","keywordMode":"all","sortBy":"newest","order":"desc