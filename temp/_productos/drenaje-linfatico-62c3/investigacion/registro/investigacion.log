nviene consultar directamente el informe de cierre 2025 de la CCCE."],"durationSeconds":7.945780250000004,"searchCount":1},"tool_result_meta":[{"id":"toolu_01MVVtApLviUfiQMinjJ2CSk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
