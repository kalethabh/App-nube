    "speed": 1.12
  },
  "duracion": 52.384,
  "lineas": [
    {
      "toma": 1,
      "tipo": "A",
      "texto": "¿Por qué tus glúteos no crecen aunque hagas de todo?",
      "duracionPrevista": 3.8,
      "inicio": 0.151,
      "fin": 2.868,
      "encontrada": true
    },
    {
      "toma": 2,
      "tipo": "A",
      "texto": "Mil sentadillas, cremas, pastillas… y el jean sigue igual de plano.",
      "duracionPrevista": 4.6,
      "inicio": 3.309,
      "fin": 8.336,
      "encontrada": true
    },
    {
      "toma": 3,
      "tipo": "A",
      "texto": "Y ya estabas ahorrando para una cirugía de millones.",
      "duracionPrevista": 3.8,
      "inicio": 8.882,
      "fin": 11.517,
      "encontrada": true
    },
    {
      "toma": 4,
      "tipo": "B",
      "texto": "Pero el problema no está afuera, está adentro: tu músculo está dormido.",
      "duracionPrevista": 5,
      "inicio": 12.109,
      "fin": 16.521,
      "encontrada": true
    },
    {
      "toma": 5,
      "tipo": "B",
      "texto": "Sin lo que necesita, no crece ni se llena. Y ninguna crema llega hasta allá.",
      "duracionPrevista": 5.8,
      "inicio": 16.973,
      "fin": 21.35,
      "encontrada": true
    },
    {
      "toma": 6,
      "tipo": "A",
      "texto": "Ahí entra Aguaje Complex: fenogreco, aguaje y maca negra. Triple acción.",
      "duracionPrevista": 4.6,
      "inicio": 21.838,
      "fin": 27.62,
      "encontrada": true
    },
    {
      "toma": 7,
      "tipo": "B",
      "texto": "Le dan a tu músculo lo que le faltaba y lo despiertan desde adentro.",
      "duracionPrevista": 5.4,
      "inicio": 28.212,
      "fin": 31.544,
      "encontrada": true
    },
    {
      "toma": 8,
      "tipo": "A",
      "texto": "Día diez: el jean ya no te queda suelto.",
      "duracionPrevista": 3.3,
      "inicio": 32.078,
      "fin": 34.968,
      "encontrada": true
    },
    {
      "toma": 9,
      "tipo": "B",
      "texto": "Día veinte: te miras de lado… y hay curva.",
      "duracionPrevista": 2.9,
      "inicio": 35.363,
      "fin": 38.335,
      "encontrada": true
    },
    {
      "toma": 10,
      "tipo": "A",
      "texto": "Día treinta: todos voltean a verte en la calle.",
      "duracionPrevista": 3.3,
      "inicio": 38.777,
      "fin": 41.679,
      "encontrada": true
    },
    {
      "toma": 11,
      "tipo": "A",
      "texto": "Sin bisturí, sin rebote y sin pagar millones. Solo dos cápsulas al día con las comidas.",
      "duracionPrevista": 6.3,
      "inicio": 41.969,
      "fin": 47.473,
      "encontrada": true
    },
    {
      "toma": 12,
      "tipo": "A",
      "texto": "Pide hoy el tratamiento completo de tres frascos y pagas cuando te llegue a la casa.",
      "duracionPrevista": 6.7,
      "inicio": 47.902,
      "fin": 52.117,
      "encontrada": true
    }
  ],
