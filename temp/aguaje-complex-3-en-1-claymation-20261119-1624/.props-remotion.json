o-6.mp4"]},{"linea":7,"texto":"Sin lo que necesitan, no se llenan ni suben.","inicio":16.37,"fin":18.797,"ventana":2.427,"tipo":"A","clips":["paso-7.mp4"]},{"linea":8,"texto":"Y ninguna crema llega hasta allá.","inicio":18.797,"fin":20.654,"ventana":1.857,"tipo":"A","clips":["paso-8.mp4"]},{"linea":9,"texto":"Hasta que llega Aguaje Complex 3 en 1.","inicio":20.654,"fin":23.441,"ventana":2.787,"tipo":"A","clips":["paso-9.mp4"]},{"linea":10,"texto":"Aguaje, fenogreco y maca negra: Extractos puros, triple acción.","inicio":23.441,"fin":28.7,"ventana":5.259,"tipo":"A","clips":["paso-10.mp4"]},{"linea":11,"texto":"Es lo que realmente hace que tengas resultados, no una marca. Llegan directo al músculo y lo despiertan.","inicio":28.7,"fin":34.749,"ventana":6.049,"tipo":"B","clips":["toma-11.mp4","paso-11.mp4"]},{"linea":12,"texto":"Primero notas que el jean ya te ajusta atrás.","inicio":34.749,"fin":37.315,"ventana":2.566,"tipo":"A","clips":["paso-12.mp4"]},{"linea":13,"texto":"Después, te miras de lado y hay muy buenas curvas.","inicio":37.315,"fin":40.914,"ventana":3.599,"tipo":"A","clips":["paso-13.mp4"]},{"linea":14,"texto":"Y luego todos los hombres y hasta las mujeres con envídia voltean a verte en la calle.","inicio":40.914,"fin":45.581,"ventana":4.667,"tipo":"A","clips":["paso-14.mp4"]},{"linea":15,"texto":"Sin bisturí, sin rebote, sin vivir en el gym.","inicio":45.581,"fin":48.146,"ventana":2.565,"tipo":"A","clips":["paso-15.mp4"]},{"linea":16,"texto":"Ese es el que necesitas: Aguaje Complex de Vitalabh, tres en uno.","inicio":48.146,"fin":52.129,"ventana":3.983,"tipo":"A","clips":["paso-16.mp4"]},{"linea":17,"texto":"Si quieres resultados rápidos, sin efecto rebote y que te duren los resultados después... el tratamiento completo de 3 unidades es la mejor opción.","inicio":52.129,"fin":59.908,"ventana":7.779,"tipo":"A","clips":["toma-17.mp4"]}],"continuidad":{"reglas":{"guia":2,"fuerte":2.5,"minima":1,"minimaCierre":0.9,"temprano":0.3,"tarde":0.4},"velocidadMaxima