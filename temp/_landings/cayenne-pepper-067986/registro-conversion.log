","anuncios-realista-narrado","anuncios-replicador-ganchos","anuncios-skeleton-ads","anuncios-sketch","anuncios-talking-object-pixar","anuncios-ugc","anuncios-zack-d-films","investigacion-mercado","investigacion-trendtrack","deep-research","design","design-sync","dataviz","update-config","verify","debug","code-review","simplify","batch","fewer-permission-prompts","doctor","loop","schedule","send-to-project","claude-api","workflow-authoring","run","run-skill-generator","plugin-authoring"],"plugins":[{"name":"cc-plugin-agents-md","path":"builtin","source":"cc-plugin-agents-md@builtin"},{"name":"cc-plugin-telemetry","path":"builtin","source":"cc-plugin-telemetry@builtin"},{"name":"cc-plugin-plugin-authoring","path":"builtin","source":"cc-plugin-plugin-authoring@builtin"}],"capabilities":["interrupt_receipt_v1","interrupt_cancel_queued_v1","interrupt_send_now_v1","interrupt_requeue_taken_v1","msg_lifecycle_v1","request_marker_lists_v1","ask_user_question_unanswered_v1","lifecycle_wakeup_source_v1","sdk_mcp_tools_list_changed","sdk_mcp_manifests","mcp_read_resource_v1","mcp_tool_ui_meta_v1","ui_surface_v1","mcp_call_result_not_for_model_v1"],"analytics_disabled":false,"product_feedback_disabled":false,"uuid":"1b65ef00-c7ba-4734-85af-77383d3f1641","memory_paths":{"auto":"/Users/kalethabh/.claude/projects/-Users-kalethabh-Anuncios-con-IA/memory/"},"original_cwd":"/Users/kalethabh/Anuncios con IA","additional_directories":[],"messaging_socket_path":"/tmp/cc-socks/98796.sock","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","per_turn_effort_active":true,"ultrathink_available":false,"view_mode":"default"}
