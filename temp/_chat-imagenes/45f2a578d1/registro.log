        \"block_id\": \"block_01\",\n432\t        \"block_type\": \"[Only real visible block types from the source: headline, product, person, background, decorative element, or other visible module]\",\n433\t        \"position\": \"[Exact position in the source]\",\n434\t        \"visual_function\": \"[What this block does visually or commercially]\",\n435\t        \"adaptation_rule\": \"[How this block is adapted to the user's product while preserving the same structure]\",\n436\t        \"present_in_reference\": true\n437\t      }\n438\t    ],\n439\t    \"forbidden_additions\": [\n440\t      \"[Visual or text modules NOT present in the source that must not be added]\"\n441\t    ]\n442\t  },\n443\t  \"visual_prompt\": \"[One complete production-ready visual prompt in English. It must recreate the exact layout logic, block placement, hierarchy, spacing and structural composition of the source while applying the approved global identity. Describe the user's product by its exact visual geometry, packaging, material, label, colors and proportions. Explicitly instruct the model to use the attached product image as the only source of truth for the product, and not to redesign, replace or reinterpret it. Include only the visual elements and text blocks clearly present in the source. Do not add CTA buttons, price badges, benefit lists, icons, trust badges, rating stars, bottom bars, discount labels, social proof, testimonials or extra text blocks if they are not present in the source.]\",\n444\t  \"text_layers\": [\n445\t    {\n446\t      \"block_id\": \"text_block_01\",\n447\t      \"reference_function\": \"[main headline / subtitle / CTA / price / badge / benefit / trust item / rating / testimonial / other]\",\n448\t      \"reference_position\": \"[Exact position in the source]\",\n449\t      \"text_style\": \"[Typography style, size, weight, color contrast, alignment and visual behavior]\",\n450\t      \"text\": \"[Final visible text in the user's chosen language]\"\n451\t    }\n452\t  ],\n453\t  \"mandatory_visual_elements\": [\n454\t    \"[Non-text visual elements clearly present in the source and required in the final prompt]\"\n455\t  ],\n456\t  \"final_generation_exclusions\": [\n457\t    \"[Specific elements that must not appear, based on the structure analysis.]\",\n458\t    \"Do not add any visual module that is not described in this prompt.\",\n459\t    \"Do not add any text that is not listed in the EXACT VISIBLE TEXT section.\",\n460\t    \"Do not add CTA buttons, prices, badges, benefits, icons, trust seals, ratings, testimonials, bottom bars, discount labels, offer boxes or extra claims unless they are explicitly listed in detected_visual_blocks or text_layers.\",\n461\t    \"Preserve the translated structure exactly. Do not complete or improve the layout with additional advertising elements.\"\n462\t  ],\n463\t  \"meta_policy_check\": \"All visible text has been sanitized for Facebook/Instagram Ads compliance. No prohibited claims, no false guarantees and no direct personal attribute callouts.\",\n464\t  \"language_rule\": \"All visible text inside the generated image must be written in [user's chosen language].\"\n465\t}\n466\t```\n467\t"}]},"parent_tool_use_id":null,"session_id":"f620b3cd-f529-4220-99bb-b3fb7b4f56b2","uuid":"a0a0b598-33b2-4c76-8c84-22b4e525e2eb","timestamp":"2026-11-27T12:32:57.676Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/kalethabh/Anuncios con IA/.claude/skills/anuncios-imagen-ads/SKILL.md","content":"  },\n  \"technical_specs\": {\n    \"dimensions\": \"1080x1080 px\",\n    \"aspect_ratio\": \"1:1 Square\",\n    \"output_goal\": \"High-conversion premium e-commerce image ad\"\n  },\n  \"global_identity\": {\n    \"color_palette\": \"[Approved palette from Step 2. Overrides the reference colors unless the user asks otherwise.]\",\n    \"visual_style\": \"[Approved visual style from Step 2]\",\n    \"visual_atmosphere\": \"[Approved atmosphere from Step 2]\",\n    \"graphic_la