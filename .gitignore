# Claves — NUNCA se comparten (y sus temporales al guardarlas: .env.<n>.tmp)
.env
.env.*.tmp

# Lo instalado (cada computador lo instala solo)
node_modules/
remotion/node_modules/
remotion/out/
.cache/

# Guardado automático (app/server/lib/guardado.js): lo liviano de temp/ (guiones, manifiestos, ajustes) se sube a
# GitHub; los videos, audios e imágenes de cada anuncio van a Google Drive y se borran de la Mac al terminar.
*.mp4
*.mov
*.webm
*.m4v
*.mp3
*.wav
*.m4a
*.aac
*.ogg
# …salvo los de la app misma (muestras de los estilos, vistas de los subestilos y la música de cada estilo)
!app/muestras/**/video.mp4
!.claude/skills/**/vista.mp4
!recursos/**/*.mp3
!.claude/skills/anuncios-sketch/assets/musica/*.mp3

# Las imágenes de cada anuncio también van a Drive (no a GitHub), menos su portada chica
temp/[!_]*/**/*.png
temp/[!_]*/**/*.jpg
temp/[!_]*/**/*.jpeg
temp/[!_]*/**/*.webp
# Lotes de imágenes: los medios se copian a la carpeta configurada, no a GitHub.
temp/_img-*/**/*.png
temp/_img-*/**/*.jpg
temp/_img-*/**/*.jpeg
temp/_img-*/**/*.webp
!temp/*/portada.jpg

# Lo que no sirve guardar
temp/_modo-prueba-*/
temp/_referencias/
temp/*/historial/
temp/*/app/registro/
# Los tramos ya armados de cada exportación del editor (produccion/exportar-tramos.js): se rehacen solos, no se suben
temp/*/app/exportes/.tramos/
temp/.conductor-mando*
# Inspiración (2026-11-17n): el código del botón de Chrome (secreto), lo que bajó ese botón y lo sacado de Meta
# (direcciones que vencen): se queda en este computador. La lista de lo guardado sí va (mis_archivos/ganadores/).
app/.extension-chrome.json
temp/_ganadores/chrome/
temp/_ganadores/meta/
app/.guardado.json
app/.guardado-config.json
app/.guardado-config.json.*.tmp
*.kie-pendiente.json
*.tmp.mp4

# Sistema
.DS_Store
Thumbs.db
npm-debug.log*
__pycache__/
*.skill.bak
.agents/
output-alumnos/

# La biblioteca (avatares, audios, clips, imágenes y aprendizajes) es su propio repositorio privado de GitHub,
# "biblioteca-anuncios", el mismo de IA-VID-AUTOMATIC: la sincroniza app/server/lib/biblioteca.js, no el guardado.
mis_archivos/biblioteca/
temp/_biblioteca-subidas/
# Los anuncios terminados de GitHub (repositorio anuncios-ia-videos): la copia sin archivos y lo que ya se bajó
# para mirarlo (app/server/lib/anuncios-github.js). No se suben al repositorio de la app.
mis_archivos/.anuncios-github/
mis_archivos/.anuncios-github-cache/

# El entorno de Python del borrador de subtítulos (npm run subtitulos:instalar)
.venv-limpio/
produccion/video-limpio/**/__pycache__/
.venv-sketch/

# copias de trabajo de los agentes de Claude Code
.claude/worktrees/

# (2026-11-20o) cachés que se rehacen solas: S.E.P (lo que trae de Meta) y lo que la coordinadora prepara para leer; los
# archivos que le pasas a la coordinadora (pueden ser videos grandes) quedan solo en este computador
temp/_sep/
temp/_oficina/adjuntos/
temp/_oficina/investigaciones/
temp/_telegram/
